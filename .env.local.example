# Supabase Dashboard -> sağ üst "Connect" butonu (veya Settings -> API Keys)
# NOT: Anahtarlar "Integrations -> Data API" sayfasında DEGILDIR.
#      Oradaki "API URL" degeri asagidaki NEXT_PUBLIC_SUPABASE_URL ile ayni seydir.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# İki biçim de çalışır:
#   yeni: sb_publishable_...   (önerilen)
#   eski: eyJhbGciOi...        (legacy "anon" anahtarı, 2026 sonunda kapanacak)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Bu ikisini BOŞ bırakırsan uygulama "DEMO modu"nda çalışır:
# veriler sunucudaki geçici bir dosyada tutulur, Supabase'e hiç bağlanmaz.
# Anahtarlarını girdiğinde gerçek veritabanına geçer.

# İsteğe bağlı: demo modunda hangi kullanıcıyla giriş yapılmış gibi davranılsın
DEMO_USER_NAME=DenemeKullanici
